# Slack (from the app created via slack-manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Your Slack user ID (profile -> ... -> Copy member ID). Only this user can direct the agents.
PM_SLACK_USER_ID=U0123456

# Claude subscription: run `claude setup-token` once on your Mac, paste the token here
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# GitHub (fine-grained token with contents + pull requests on the vault and target repos)
GH_TOKEN=github_pat_...
VAULT_REPO=your-org/product-vault

# Orchestrator
DATA_DIR=/data
MAX_CONCURRENT_JOBS=1
APPROVAL_TIMEOUT_MIN=60
