# Slack (from the app created via slack-manifest.yaml)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Your Slack member ID (profile -> ... -> Copy member ID), format U0123456. REQUIRED: startup fails if missing/malformed.
# Only this user can direct the agents; agents @mention them when they need an answer.
PM_SLACK_USER_ID=U0123456

# Claude subscription: run `claude setup-token` once on your Mac, paste the token here
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# GitHub (fine-grained token with contents + pull requests on the vault and target repos)
GH_TOKEN=github_pat_...
VAULT_REPO=your-org/product-vault

# Orchestrator
DATA_DIR=/data
MAX_CONCURRENT_JOBS=1
APPROVAL_TIMEOUT_MIN=60
# Re-@mention the PM every N ms while a question/approval is unanswered (max 3 reminders). Default 30 min.
QUESTION_REMINDER_MS=1800000
